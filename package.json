{
  "name": "@umbraco-cms/mcp-editor",
  "version": "18.0.0-beta.11",
  "type": "module",
  "description": "MCP server that gives AI assistants editorial control over Umbraco CMS content",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./collections": "./dist/collections.js"
  },
  "bin": {
    "umbraco-mcp-editor-cms": "./dist/index.js"
  },
  "scripts": {
    "cleanup:orphans": "node scripts/kill-orphan-demosites.mjs",
    "clean": "rimraf dist",
    "sync-lockfile": "npm install --package-lock-only --ignore-scripts",
    "build": "tsup --config tsup.config.ts",
    "build:azure": "tsup --config tsup.azure.config.ts",
    "compile": "tsc --noEmit",
    "watch": "tsup --config tsup.config.ts --watch",
    "start:umbraco": "bash scripts/start-umbraco.sh",
    "stop:umbraco": "bash scripts/stop-umbraco.sh",
    "umbraco:bootstrap": "bash scripts/bootstrap-demo-site.sh",
    "start:azure": "node --import ./src/hosted/hooks/register-cloudflare-shim.mjs ./dist-azure/server.js",
    "dev:azure": "npm run build:azure && npm run start:azure",
    "inspect": "npx @modelcontextprotocol/inspector@1 node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=__tests__ --runInBand --forceExit",
    "test:one": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:changed": "node scripts/test-changed.mjs",
    "test:evals": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/evals/jest.config.ts --forceExit",
    "test:all": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=__tests__ --runInBand --forceExit && node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/evals/jest.config.ts --forceExit",
    "test:e2e": "npm run build:azure && npx playwright test --config tests/hosted-e2e/playwright.config.ts",
    "dev:worker": "npx wrangler dev",
    "deploy:worker": "npx wrangler deploy"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "Umbraco",
    "MCP",
    "Model Context Protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.87",
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/workers-oauth-provider": "^0.2.3",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@umbraco-cms/mcp-dev": "^18.1.10",
    "@umbraco-cms/mcp-hosted": "^1.0.0-beta.47",
    "@umbraco-cms/mcp-server-sdk": "^1.0.0-beta.47",
    "agents": "^0.6.0",
    "dotenv": "^16.5.0",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "uuid": "^11.1.0",
    "yargs": "^18.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@jest/types": "^29.6.3",
    "@modelcontextprotocol/inspector": "^1.0.1",
    "@playwright/test": "^1.52.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "@types/uuid": "^10.0.0",
    "@types/yargs": "^17.0.33",
    "commander": "^13.1.0",
    "jest": "^29.7.0",
    "msw": "^2.12.7",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "undici": "^7.29.0",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "commander": "^13.1.0"
  }
}
